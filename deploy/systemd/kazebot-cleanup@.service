[Unit]
Description=Kazebot periodic data cleanup (%i)
Wants=kazebot@%i.service
After=local-fs.target

[Service]
Type=oneshot
User=kazebot
Group=kazebot
WorkingDirectory=/opt/kazebot-data/%i
Environment=PYTHONPATH=/opt/kazebot
Environment=CLONOTH_WORKSPACE=/opt/kazebot-data/%i
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/opt/kazebot-data/%i/.env
# NapCat 容器里的缓存归 root，这里删不动，交给宿主清理（kazebot-host-cleanup）
ExecStart=/opt/kazebot/.venv/bin/python -m engine.data_cleanup --scope workspace
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

ProtectSystem=strict
ReadWritePaths=/opt/kazebot-data/%i
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
