[Unit]
Description=Kazebot Supervisor (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kazebot
Group=kazebot
# 工作区是实例目录，代码在 /opt/kazebot；cwd 不是代码目录，所以要显式给 PYTHONPATH
WorkingDirectory=/opt/kazebot-data/%i
Environment=PYTHONPATH=/opt/kazebot
Environment=CLONOTH_WORKSPACE=/opt/kazebot-data/%i
Environment=CLONOTH_INSTANCES_FILE=/opt/kazebot-data/instances.yaml
# 代码目录只读，几个实例同时写 __pycache__ 只会互相打架
Environment=PYTHONDONTWRITEBYTECODE=1
# engine 定时拉起的数据清理跟着它走：NapCat 容器里的缓存归宿主清理（kazebot-host-cleanup）
Environment=CLONOTH_MAINTENANCE_SCOPE=workspace
EnvironmentFile=-/opt/kazebot-data/%i/.env
ExecStart=/opt/kazebot/.venv/bin/python /opt/kazebot/main.py
Restart=always
RestartSec=3
# main.py 内部循环处理退出码 75；98 是端口被占、78 是实例配置写错，重启都无意义，停住等人
SuccessExitStatus=75
RestartPreventExitStatus=98 78
KillMode=mixed
TimeoutStopSec=30

# Agent 能执行任意命令，所以边界靠内核而不是正则黑名单
ProtectSystem=strict
ReadWritePaths=/opt/kazebot-data/%i
# 表情包库是几个号共用的一份，工作区里那个 data/stickers 只是软链；
# systemd 按真实路径判权限，不放开共享目录进程就打不开库文件。
ReadWritePaths=/opt/kazebot-data/stickers
# 加入共享配置组的实例，config/ 是指到这下面的链接，同理要放开。前面的 - 是目录还没建时照常启动。
ReadWritePaths=-/opt/kazebot-data/shared
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
