# 复制为 .env 后填写。NoneBot 与 adapters/onebot 共用本文件。
# 完整变量清单见 docs/DEPLOY-QQ.md 与 adapters/onebot/config.py。
#
# 运营期要频繁调的键（权限、白名单、触发策略、输出格式、队列、群历史条数、转发 Bridge
# 开关）改到 config/qq.yaml 就即时生效，不用重启。本文件里的同名变量仍然有效，但只在
# qq.yaml 没写那个键时才被读到。清单见 config/qq.example.yaml。

# ---- NoneBot 宿主 ----
# NapCat 反向 WebSocket 连到 ws://HOST:PORT/onebot/v11/ws
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO
# NapCat 侧配了 token 就填同一个值
ONEBOT_ACCESS_TOKEN=

# ---- Clonoth 连接 ----
CLONOTH_BASE_URL=http://127.0.0.1:8765
# 留空则取仓库根，与 supervisor 一致；分离部署时必须显式指定同一路径
CLONOTH_WORKSPACE=
# qq.orchestrator（默认，全能力）| qq.web_search（仅联网搜索的窄入口）
CLONOTH_ENTRY_NODE=qq.orchestrator

# ---- 必填：权限边界 ----
# 管理员 QQ 号（逗号分隔）。审批、主动发送、表情包管理、发送死信默认仅限这些号；
# 逐项档位在 config/qq.yaml 的 permissions.capabilities.*（只能写 yaml）
CLONOTH_ADMIN_QQ_USERS=
# 允许接入的群号（逗号分隔）。留空 = 一个群都不放行
CLONOTH_ALLOWED_GROUPS=
# 允许私聊的 QQ 号；默认仅好友，管理员始终允许。未放行的人默认得不到任何回应
CLONOTH_ALLOWED_PRIVATE_USERS=

# ---- 触发策略 ----
# 旧的单选枚举：mention_only（默认，@Bot 或被回复）| prefix（再加前缀）| all（所有消息）。
# 七个信号（含名字/关键词/随机）与冷却、LLM 意愿判定只能写 config/qq.yaml 的 trigger.*
ONEBOT_GROUP_TRIGGER=mention_only
# 分隔符必须是半角逗号
ONEBOT_TRIGGER_PREFIXES=!,！,/
# 0 = 回复不再引用+@触发者
ONEBOT_REPLY_TO_TRIGGER=1
ONEBOT_GROUP_HISTORY_MAX=20

# ---- 读图 ----
# 视觉入口节点 qq.vision 专用。三个都留空时它跑的就是主渠道那个模型，只是没有工具，
# 所以只有想让读图走另一家（便宜模型 / 专用端点）时才需要填。
# 带图消息什么时候会绕到它，看 config/runtime.yaml 的 routing.vision.enabled，
# 默认 auto = 只在主渠道自己收不下图时才绕（控制台「渠道」页可改）。
QQ_VISION_MODEL=
QQ_VISION_API_KEY=
QQ_VISION_BASE_URL=

# ---- 安全 ----
# 转发 Bridge 只听本地，但本机任何进程（含 AI 的 execute_command）都能调，所以令牌强制校验。
# 留空 = bot 自签一份写到 data/onebot_forward_bridge_token，工具进程按同一路径读；
# 跨机或两端工作区不一致时必须显式设成同一个强随机值，否则 qq_forward 全部 403
ONEBOT_FORWARD_BRIDGE_TOKEN=
# conversation_key 的 HMAC 盐。留空 = 干净工作区首启自动生成并钉进
# data/onebot_conversation_hash_secret；已有记忆的工作区则钉在无盐，加盐要走
# deploy/migrate_qq_conversation_hash.py。填了这里就以它为准 —— 改动会让已有会话映射全部失配
ONEBOT_CONVERSATION_HASH_SECRET=
